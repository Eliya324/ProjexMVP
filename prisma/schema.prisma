generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(uuid())
  username                String                   @unique
  email                   String                   @unique
  password                String?
  profilePicture          String?
  fullName                String
  professionalTitle       String?
  location                String?
  personalSummary         String?
  contactPhone            String?
  skills                  String[]
  interests               String[]
  languagesSpoken         String[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  certifications          Certification[]
  comments                Comment[]
  educations              Education[]
  likes                   Like[]
  notificationsSent       Notification[]           @relation("senderNotifications")
  notifications           Notification[]           @relation("userNotifications")
  posts                   Post[]
  professionalExperiences ProfessionalExperience[]
  ownedProjects           Project[]                @relation("Owner")
  projectRatings          ProjectRating[]
  projectRelationships    ProjectRelationship[]
  publications            Publication[]
  recommendationsSent     Recommendation[]         @relation("RecommendationFromUser")
  recommendationsReceived Recommendation[]         @relation("RecommendationToUser")
  tweets                  Tweet[]
  relationshipsSent       UserRelationship[]       @relation("RelationshipFromUser")
  relationshipsReceived   UserRelationship[]       @relation("RelationshipToUser")
}

model ProfessionalExperience {
  id          String    @id @default(uuid())
  userId      String
  jobTitle    String
  company     String
  startDate   DateTime
  endDate     DateTime?
  description String?
  user        User      @relation(fields: [userId], references: [id])
}

model Education {
  id          String    @id @default(uuid())
  userId      String
  degree      String
  institution String
  startDate   DateTime
  endDate     DateTime?
  description String?
  user        User      @relation(fields: [userId], references: [id])
}

model Recommendation {
  id         String @id @default(uuid())
  fromUserId String
  toUserId   String
  content    String
  fromUser   User   @relation("RecommendationFromUser", fields: [fromUserId], references: [id])
  toUser     User   @relation("RecommendationToUser", fields: [toUserId], references: [id])
}

model Certification {
  id          String @id @default(uuid())
  userId      String
  title       String
  institution String
  year        Int
  user        User   @relation(fields: [userId], references: [id])
}

model Publication {
  id              String   @id @default(uuid())
  userId          String
  title           String
  publicationDate DateTime
  link            String?
  user            User     @relation(fields: [userId], references: [id])
}

model Project {
  id               String                @id @default(uuid())
  ownerId          String
  title            String
  shortDescription String
  objective        String?
  requiredSkills   String[]
  usedTechnologies String[]
  missingTalents   String[]
  status           ProjectStatus
  documentPDFs     String[]
  posts            Post[]
  owner            User                  @relation("Owner", fields: [ownerId], references: [id])
  ratings          ProjectRating[]
  relationships    ProjectRelationship[]
}

model ProjectRelationship {
  id        String                  @id @default(uuid())
  projectId String
  userId    String
  type      ProjectRelationshipType
  status    MembershipStatus?
  project   Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserRelationship {
  id         String             @id @default(uuid())
  fromUserId String
  toUserId   String
  type       RelationshipType
  status     RelationshipStatus
  fromUser   User               @relation("RelationshipFromUser", fields: [fromUserId], references: [id])
  toUser     User               @relation("RelationshipToUser", fields: [toUserId], references: [id])
}

model ProjectRating {
  id        String  @id @default(uuid())
  userId    String
  projectId String
  rating    Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id            String         @id @default(uuid())
  projectId     String
  authoeId      String
  content       String
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  comments      Comment[]
  likes         Like[]
  notifications Notification[]
  author        User           @relation(fields: [authoeId], references: [id], onDelete: Cascade)
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
  @@index([userId, postId])
}

model Tweet {
  id        String   @id @default(uuid())
  userId    String
  content   String
  image     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(uuid())
  authorId  String
  postId    String
  content   String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([authorId, postId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  senderId  String
  type      NotificationType
  read      Boolean          @default(false)
  postId    String?
  content   String
  createdAt DateTime         @default(now())
  post      Post?            @relation(fields: [postId], references: [id])
  sender    User             @relation("senderNotifications", fields: [senderId], references: [id])
  user      User             @relation("userNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
}

enum ProjectRelationshipType {
  MEMBER
  FOLLOWER
}

enum MembershipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum RelationshipType {
  FRIEND
  FOLLOWER
}

enum RelationshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  PROJECT_RELATIONSHIP
}
